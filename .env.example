# 복사해서 .env.local 로 쓰세요. 설명: docs/SHOP_SETUP.md

# 견적 메일 · 주문 메일 (Gmail SMTP)
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# 새 주문 알림 받을 주소 (없으면 777@atx.kr)
ADMIN_NOTIFY_EMAIL=

# Supabase — 주름관 전용 새 프로젝트 (온라인 구매)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 포트원 V2
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# 관리자 (/admin)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 방문 분석 (비워 두면 꺼짐)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_NAVER_WA=
